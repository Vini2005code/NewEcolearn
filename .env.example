# Local development: SQLite remains available without external configuration.
ECOLEARN_DB_PATH=data/ecolearn.sqlite

# Netlify Database is configured automatically by the platform on deploy.
# Do not copy SQLite data files to the Netlify runtime.

# Optional: use another managed PostgreSQL database instead of Netlify Database.
# Set DATABASE_URL as a secret in the hosting environment, never in NEXT_PUBLIC_*.
# DATABASE_URL=postgresql://user:password@host:5432/ecolearn?sslmode=require
